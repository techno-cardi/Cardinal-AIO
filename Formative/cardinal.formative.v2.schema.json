{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardinal.local/schemas/cardinal.formative.v2.schema.json",
  "title": "Cardinal Formative Package v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocolVersion", "packageMode", "assessment", "sources", "items", "issues"],
  "properties": {
    "schema": {"const": "cardinal.formative/2"},
    "protocolVersion": {"const": "2.0.0"},
    "packageMode": {"enum": ["full", "patch"]},
    "assessment": {"$ref": "#/$defs/assessment"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/sectionItem"},
          {"$ref": "#/$defs/instructionItem"},
          {"$ref": "#/$defs/questionItem"},
          {"$ref": "#/$defs/passageGroupItem"}
        ]
      }
    },
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "generator": {"$ref": "#/$defs/generator"},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "sourceMode"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2},
        "sourceMode": {"enum": ["external-reference-only", "embedded"]},
        "declaredTotalPoints": {"$ref": "#/$defs/pointValue"},
        "targetHint": {"type": "string", "minLength": 1}
      }
    },
    "pointValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "multipleOf": 0.1},
        "provenance": {"enum": ["provided", "proposed", "derived"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "label", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
        "role": {"enum": ["questionnaire", "text", "answerKey", "rubric", "appendix", "unknown"]},
        "label": {"type": "string", "minLength": 1},
        "fileName": {"type": ["string", "null"]},
        "status": {"enum": ["provided", "missing", "external"]},
        "binarySha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "semanticFingerprint": {"type": "string", "minLength": 8},
        "pageCount": {"type": "integer", "minimum": 1}
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "promptExact"],
      "properties": {
        "sourceRef": {"type": "string", "minLength": 1},
        "page": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}, {"type": "null"}]},
        "printedPage": {"type": ["string", "null"]},
        "number": {"type": ["string", "null"]},
        "subNumber": {"type": ["string", "null"]},
        "promptExact": {"type": "string", "minLength": 1}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["warning", "blocker"]},
        "code": {"type": "string", "minLength": 2, "pattern": "^[A-Z0-9_:-]+$"},
        "message": {"type": "string", "minLength": 1},
        "itemId": {"type": "string", "minLength": 1},
        "sourceRef": {"type": "string", "minLength": 1}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description", "requiresReview"],
      "properties": {
        "code": {"enum": ["removeSourceNumber", "normalizeTypography", "splitQuestion", "mergeQuestion", "changeResponseType", "other"]},
        "description": {"type": "string", "minLength": 1},
        "requiresReview": {"type": "boolean"}
      }
    },
    "points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance", "graded", "bonus"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "multipleOf": 0.1},
        "provenance": {"enum": ["provided", "proposed", "derived"]},
        "graded": {"type": "boolean"},
        "bonus": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["providedAnswerKey", "sourceExplicit", "sourceInferred", "questionIntrinsic", "teacherApproved", "sourceMissing"]},
        "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "note": {"type": "string"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["distinctConcepts", "explainEach", "compareSources", "argumentAndEvidence", "chooseNofM", "citation", "relation", "other"]},
        "count": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "score", "provenance", "terms"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "score": {"type": "number", "minimum": 0, "multipleOf": 0.1},
        "provenance": {"enum": ["providedAnswerKey", "sourceExplicit", "sourceInferred", "questionIntrinsic", "teacherApproved", "sourceMissing"]},
        "terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "riskyTerms": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "provenance"],
      "properties": {
        "mode": {"enum": ["auto", "assisted", "manual"]},
        "expectedAnswer": {"type": "string"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "partialCredit": {"type": "boolean"},
        "caseSensitive": {"type": "boolean"},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "concepts": {"type": "array", "items": {"$ref": "#/$defs/concept"}}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "correct"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "correct": {"type": "boolean"},
        "score": {"type": "number", "minimum": 0, "multipleOf": 0.1}
      }
    },
    "blank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "answers"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "answers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "conceptIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "dropdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "options", "correct"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "correct": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {"type": "string", "minLength": 1},
        "right": {"type": "string", "minLength": 1}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "options": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/option"}},
        "blanks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blank"}},
        "dropdowns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dropdown"}},
        "sequence": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "pairs": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/pair"}}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showWordCount": {"type": "boolean"},
        "randomizeChoices": {"type": "boolean"}
      }
    },
    "sectionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "order", "content"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "section"},
        "order": {"type": "integer", "minimum": 1},
        "content": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceLocation"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    },
    "instructionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "order", "content"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "instruction"},
        "order": {"type": "integer", "minimum": 1},
        "content": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceLocation"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    },
    "passageGroupItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "order", "embed", "sourceRefs", "content", "questionIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "passageGroup"},
        "order": {"type": "integer", "minimum": 1},
        "embed": {"const": true},
        "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "content": {"type": "string", "minLength": 1},
        "questionIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "source": {"$ref": "#/$defs/sourceLocation"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    },
    "questionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "order", "source", "prompt", "subtype", "required", "points", "grading", "transformations", "issues"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "question"},
        "order": {"type": "integer", "minimum": 1},
        "source": {"$ref": "#/$defs/sourceLocation"},
        "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "prompt": {"type": "string", "minLength": 1},
        "subtype": {"enum": ["shortAnswer", "longAnswer", "multipleChoice", "multipleSelection", "fillInTheBlank", "inlineChoice", "resequence", "matching", "unsupported"]},
        "required": {"type": "boolean"},
        "points": {"$ref": "#/$defs/points"},
        "grading": {"$ref": "#/$defs/grading"},
        "response": {"$ref": "#/$defs/response"},
        "settings": {"$ref": "#/$defs/settings"},
        "transformations": {"type": "array", "items": {"$ref": "#/$defs/transformation"}},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      },
      "allOf": [
        {"if": {"properties": {"subtype": {"enum": ["multipleChoice", "multipleSelection"]}}}, "then": {"required": ["response"], "properties": {"response": {"required": ["options"]}}}},
        {"if": {"properties": {"subtype": {"const": "fillInTheBlank"}}}, "then": {"required": ["response"], "properties": {"response": {"required": ["blanks"]}}}},
        {"if": {"properties": {"subtype": {"const": "inlineChoice"}}}, "then": {"required": ["response"], "properties": {"response": {"required": ["dropdowns"]}}}},
        {"if": {"properties": {"subtype": {"const": "resequence"}}}, "then": {"required": ["response"], "properties": {"response": {"required": ["sequence"]}}}},
        {"if": {"properties": {"subtype": {"const": "matching"}}}, "then": {"required": ["response"], "properties": {"response": {"required": ["pairs"]}}}}
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {"type": "string"},
        "model": {"type": "string"},
        "generatedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
